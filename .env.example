PORT=4173
ASTRA_DB_PATH=./data/astra.sqlite
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Gemini keys stay on the server. The second key is tried only after an auth,
# quota, or transient provider failure. Never put either value in frontend code.
ASTRA_GEMINI_API_KEY=
ASTRA_GEMINI_API_KEY_2=
ASTRA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ASTRA_LLM_MODEL=gemini-3.8-flash
# Optional compatibility key for another OpenAI-compatible provider.
ASTRA_LLM_API_KEY=
# Optional direct OpenAI connection. Keep this key in .env on the server only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
